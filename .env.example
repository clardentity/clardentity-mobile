# Copy to .env.local and fill in what you need. Everything is optional.

# Backend (defaults to production)
EXPO_PUBLIC_BACKEND_URL=https://clardentity-backend.onrender.com
# EXPO_PUBLIC_API_URL=https://clardentity-backend.onrender.com/api/v1

# Analytics stay off unless a key is set
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google sign-in (development build only). The web client ID is what the
# backend verifies; the iOS client ID also adds the config plugin.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple, once the backend has POST /auth/oauth/apple
# EXPO_PUBLIC_APPLE_SIGN_IN=1

# Set after `eas init`
# EAS_PROJECT_ID=
