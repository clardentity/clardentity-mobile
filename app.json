{
  "expo": {
    "name": "Clardentity",
    "slug": "clardentity",
    "scheme": "clardentity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-512.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f3f4",
    "ios": {
      "bundleIdentifier": "ai.clardentity.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Clardentity uses the microphone for voice notes, dictation and live calls with your companion.",
        "NSCameraUsageDescription": "Clardentity uses the camera so you can attach a photo to a question.",
        "NSPhotoLibraryUsageDescription": "Clardentity opens your photo library so you can attach an image to a question."
      }
    },
    "android": {
      "package": "ai.clardentity.app",
      "adaptiveIcon": {
        "backgroundColor": "#6b2d5c",
        "foregroundImage": "./assets/brand/icon-maskable-512.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/apple-touch-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Clardentity uses the microphone for voice notes, dictation and live calls with your companion."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Clardentity opens your photo library so you can attach an image to a question.",
          "cameraPermission": "Clardentity uses the camera so you can attach a photo to a question."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon-512.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f5f3f4",
          "dark": {
            "backgroundColor": "#131011"
          }
        }
      ],
      "expo-status-bar",
      "@config-plugins/react-native-webrtc",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    }
  }
}
